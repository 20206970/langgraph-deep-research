# LLM Configuration (OpenAI-compatible)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Local Embeddings Configuration (for long-term memory vector store)
# BGE-M3 runs locally through sentence-transformers; no API key is needed.
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DEVICE=auto
# 6 GB local GPU: 8. Raise to 16 on a 12 GB deployment GPU after load testing.
EMBEDDINGS_BATCH_SIZE=8
EMBEDDINGS_MAX_LENGTH=1024
EMBEDDINGS_NORMALIZE=true

# Search API
TAVILY_API_KEY=tvly-xxx

# Paper Search (built-in, no API key needed)
# Supports ArXiv and Semantic Scholar

# Memory Configuration
# Do not reuse a directory built with another embedding model.
CHROMA_PERSIST_DIR=./chroma_data_bge_m3
LONG_TERM_MEMORY_K=3
SHORT_TERM_MAX_TOKENS=2000

# P1.1 plan/run persistence and LangGraph checkpoints
RESEARCH_DB_PATH=./research.db

# Server
HOST=0.0.0.0
PORT=8000
