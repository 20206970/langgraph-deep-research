# LLM Configuration (OpenAI-compatible)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# P1.3 role routing. Every role falls back to OPENAI_MODEL until explicitly set.
ROUTER_MODEL=
PLANNER_MODEL=
SUMMARIZER_MODEL=
REPORTER_MODEL=
REPAIR_MODEL=
JUDGE_MODEL=
# Each role also accepts <ROLE>_TEMPERATURE and <ROLE>_MAX_TOKENS overrides.
# Optional explicit model pricing: {"model-name":{"input_per_million":0,"output_per_million":0}}
MODEL_PRICING_JSON=

# Local Embeddings Configuration (for long-term memory vector store)
# BGE-M3 runs locally through sentence-transformers; no API key is needed.
EMBEDDINGS_PROVIDER=huggingface
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DEVICE=auto
# 6 GB local GPU: 8. Raise to 16 on a 12 GB deployment GPU after load testing.
EMBEDDINGS_BATCH_SIZE=8
EMBEDDINGS_MAX_LENGTH=1024
EMBEDDINGS_NORMALIZE=true

# Search API
TAVILY_API_KEY=tvly-xxx

# Paper Search (built-in, no API key needed)
# Supports ArXiv and Semantic Scholar

# Memory Configuration
# Do not reuse a directory built with another embedding model.
CHROMA_PERSIST_DIR=./chroma_data_bge_m3
LONG_TERM_MEMORY_K=3
SHORT_TERM_MAX_TOKENS=2000

# P1.1 plan/run persistence and LangGraph checkpoints
RESEARCH_DB_PATH=./research.db

# P1.3 live-search cache and run budgets
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL_SECONDS=86400
SEARCH_LANGUAGE=auto
SEARCH_TOOL_VERSION=p1.3
RUN_MAX_TASKS=5
RUN_MAX_SEARCH_ATTEMPTS=3
RUN_MAX_FORMAT_REPAIRS=1
RUN_MAX_TOTAL_TOKENS=
RUN_MAX_ESTIMATED_COST=
RUN_MAX_ELAPSED_SECONDS=300

# Optional LangSmith tracing; disabled by default and content capture remains off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-deep-research-dev
LANGSMITH_ENDPOINT=
LANGSMITH_SAMPLE_RATE=1.0
LANGSMITH_CAPTURE_CONTENT=false
LANGSMITH_RETENTION_DAYS=14
LANGSMITH_REDACT_PATTERNS=

# Server
HOST=0.0.0.0
PORT=8000
